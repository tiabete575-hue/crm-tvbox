{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crm-tv",
  "main": "cloudflare-worker.ts",
  "triggers": { "crons": ["0 11 * * *"] },
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
